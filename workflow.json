    {
      "parameters": {
        "jsCode": "const inputText = $input.first().json.text;\n\n// Improved regex to capture find() and findOne() queries along with optional projection\nconst match = inputText.match(/(?:find|findOne)\\s*\\(\\s*([\\s\\S]*?)\\s*(?:,\\s*([\\s\\S]*?))?\\s*\\)/);\n\nif (match && match[1]) {\n  try {\n    const queryString = match[1].trim();\n    const projectionString = match[2] ? match[2].trim() : \"{}\";\n\n    // Convert MongoDB-style object notation to valid JSON format\n    const sanitizedQuery = queryString.replace(/(\\w+):/g, '\"$1\":');\n    const sanitizedProjection = projectionString.replace(/(\\w+):/g, '\"$1\":');\n\n    // Parse JSON safely\n    const extractedQuery = JSON.parse(sanitizedQuery);\n    const extractedProjection = JSON.parse(sanitizedProjection);\n\n    return [{ query: extractedQuery, projection: extractedProjection }];\n  } catch (error) {\n    return [{ error: `Invalid JSON format in query or projection: ${error.message}` }];\n  }\n} else {\n  return [{ error: \"No valid query found\" }];\n}\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        2760
      ],
      "id": "6b753b24-89d2-4b07-acca-1bf7d7acae31",
      "name": "Code2"
    },
    {
      "parameters": {
        "jsCode": "const inputText = $input.first().json.text;\n\n// Regex to capture the aggregation pipeline inside aggregate([...])\nconst match = inputText.match(/aggregate\\s*\\(\\s*(\\[[\\s\\S]*?\\])\\s*\\)/);\n\nif (match && match[1]) {\n  try {\n    let extractedPipeline = match[1];\n\n    // Convert MongoDB extended JSON (unquoted keys) into valid JSON format\n    extractedPipeline = extractedPipeline\n      .replace(/([{,]\\s*)([$\\w]+)\\s*:/g, '$1\"$2\":'); // Add quotes around keys\n\n    const parsedPipeline = JSON.parse(extractedPipeline);\n    return [{ pipeline: parsedPipeline }];\n  } catch (error) {\n    return [{ error: \"Invalid JSON format in aggregation pipeline\", details: error.message }];\n  }\n} else {\n  return [{ error: \"No valid aggregation pipeline found\" }];\n}\n"
      },
